#!/usr/bin/env bash
# Fast local QA pre-commit hook (installed via pipeline/scripts/install-hooks.sh)
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "[pre-commit] check-assets.py"
python3 pipeline/scripts/check-assets.py

echo "[pre-commit] Python unit tests"
python3 -m unittest discover -s tests
python3 -m unittest discover -s pipeline/tests

if git diff --cached --name-only | grep -q '^video-engine/'; then
  echo "[pre-commit] video-engine typecheck + vitest"
  export PATH="$HOME/.nvm/versions/node/v22.22.0/bin:$PATH"
  (cd video-engine && npm run typecheck && npm test)
fi
