#!/usr/bin/env bash
# Local pre-commit hook (installed via pipeline/scripts/install-hooks.sh).
# The checks live in pipeline/scripts/preflight.sh (single source of truth), so agents without native
# hooks (e.g. Grok) run the identical gate with: bash pipeline/scripts/preflight.sh
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
exec bash "$ROOT/pipeline/scripts/preflight.sh" --staged
