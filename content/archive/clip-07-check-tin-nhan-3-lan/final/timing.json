 "lines": [
  {
   "beat": "clip-07.b01",
   "scene": "b01",
   "speaker": "hiep",
   "say": "Sếp nhắn đúng hai chữ",
   "en": "Boss texts two words",
   "emotion": "neutral",
   "key": "c07v2-b01",
   "local": 0.12,
   "dur": 1.299,
   "t": 0.12
  },
  {
   "beat": "clip-07.b01",
   "scene": "b01a",
   "speaker": "hiep",
   "say": "em ơi, rồi im luôn.",
   "en": "“hey” then goes silent.",
   "emotion": "confused",
   "key": "c07v2-b01a",
   "local": 0.02,
   "dur": 1.225,
   "t": 1.499
  },
  {
   "beat": "clip-07.b01",
   "scene": "b01b",
   "speaker": "hiep",
   "say": "mười phút mình mở máy coi năm lần.",
   "en": "Checked five times in ten minutes.",
   "emotion": "sad",
   "key": "c07v2-b01b",
   "local": 0.02,
   "dur": 1.893,
   "t": 2.804
  },
  {
   "beat": "clip-07.b02",
   "scene": "b02",
   "speaker": "hiep",
   "say": "Hông riêng bữa đó đâu.",
   "en": "Not just that one day.",
   "emotion": "sad",
   "key": "c07v2-b02",
   "local": 0.45,
   "dur": 1.309,
   "t": 5.207
  },
  {
   "beat": "clip-07.b02",
   "scene": "b02a",
   "speaker": "hiep",
   "say": "Ngày thường cứ thấy chấm đỏ, là tay mình tự chụp máy.",
   "en": "Red dot pops, hand grabs phone.",
   "emotion": "neutral",
   "key": "c07v2-b02a",
   "local": 0.15,
   "dur": 2.985,
   "t": 6.916
  },
  {
   "beat": "clip-07.b02",
   "scene": "b02b",
   "speaker": "hiep",
   "say": "Tối về đầu nặng trịch, việc chính còn nguyên, mình lại tự trách sao dễ phân tâm quá.",
   "en": "Exhausted at night, blaming my focus.",
   "emotion": "sad",
   "key": "c07v2-b02b",
   "local": 0.15,
   "dur": 4.69,
   "t": 10.301
  },
  {
   "beat": "clip-07.b03",
   "scene": "b03",
   "speaker": "hiep",
   "say": "Tắt chuông cũng thua.",
   "en": "Even muting alerts fails.",
   "emotion": "sad",
   "key": "c07v2-b03",
   "local": 0.45,
   "dur": 1.183,
   "t": 15.691
  },
  {
   "beat": "clip-07.b03",
   "scene": "b03a",
   "speaker": "hiep",
   "say": "Mình vẫn lén bật màn hình coi, sợ việc gấp người ta kiếm hông ra.",
   "en": "I still peek, fearing missed pings.",
   "emotion": "neutral",
   "key": "c07v2-b03a",
   "local": 0.15,
   "dur": 3.75,
   "t": 17.274
  },
  {
   "beat": "clip-07.b03",
   "scene": "b03b",
   "speaker": "hiep",
   "say": "Ủa mà canh liền tay vậy, mình đỡ trễ việc hay chỉ căng đầu thêm?",
   "en": "Faster work, or just more stress?",
   "emotion": "confused",
   "key": "c07v2-b03b",
   "local": 0.15,
   "dur": 3.708,
   "t": 21.424
  },
  {
   "beat": "clip-07.b04",
   "scene": "b04",
   "speaker": "hiep",
   "say": "Nhóm Cu lép năm hai ngàn mười lăm đo trên i meo nè:",
   "en": "Kushlev 2015 tested this on email:",
   "emotion": "focused",
   "key": "c07v2-b04",
   "local": 0.45,
   "dur": 2.688,
   "t": 25.832
  },
  {
   "beat": "clip-07.b04",
   "scene": "b04a",
   "speaker": "hiep",
   "say": "tuần gom còn ba lần một ngày, so với thả cửa hơn mười lăm lần, căng thẳng giảm rõ mức vừa phải.",
   "en": "3 checks vs over 15: less stress.",
   "emotion": "focused",
   "key": "c07v2-b04a",
   "local": 0.15,
   "dur": 5.495,
   "t": 28.92
  },
  {
   "beat": "clip-07.b05",
   "scene": "b05",
   "speaker": "hiep",
   "say": "Số i meo nhận với trả lời vẫn y như cũ.",
   "en": "Emails received and replied stayed identical.",
   "emotion": "focused",
   "key": "c07v2-b05",
   "local": 0.45,
   "dur": 2.325,
   "t": 35.115
  },
  {
   "beat": "clip-07.b05",
   "scene": "b05a",
   "speaker": "hiep",
   "say": "Nghe vậy tự nhiên nhẹ hẳn cái vai, hóa ra mình hông yếu, chỉ tại mở ra đóng vô cả ngày nên đầu căng hà.",
   "en": "Instant relief. Just constant switching.",
   "emotion": "neutral",
   "key": "c07v2-b05a",
   "local": 0.15,
   "dur": 5.883,
   "t": 37.84
  },
  {
   "beat": "clip-07.b06",
   "scene": "b06",
   "speaker": "hiep",
   "say": "Từ đó mình đổi luật, báo trước với tim, việc gấp thì gọi nha.",
   "en": "New rule: tell your team to call.",
   "emotion": "focused",
   "key": "c07v2-b06",
   "local": 0.45,
   "dur": 3.387,
   "t": 44.423
  },
  {
   "beat": "clip-07.b06",
   "scene": "b06a",
   "speaker": "hiep",
   "say": "Còn tin nhắn cứ gom đúng ba khung giờ, chín giờ sáng, một giờ trưa, bốn giờ chiều, mở một lượt rồi xử gọn.",
   "en": "Batch messages at 9, 1, and 4.",
   "emotion": "focused",
   "key": "c07v2-b06a",
   "local": 0.15,
   "dur": 6.431,
   "t": 48.21
  },
  {
   "beat": "clip-07.b07",
   "scene": "b07",
   "speaker": "hiep",
   "say": "Mình gỡ kiểu đó thôi, chứ mỗi chỗ làm mỗi khác.",
   "en": "Just my workaround; every job differs.",
   "emotion": "happy",
   "key": "c07v2-b07",
   "local": 0.45,
   "dur": 2.68,
   "t": 55.341
  },
  {
   "beat": "clip-07.b07",
   "scene": "b07a",
   "speaker": "hiep",
   "say": "Có ai cũng hay canh chấm đỏ giống mình hông?",
   "en": "Anyone else glued to red dots?",
   "emotion": "happy",
   "key": "c07v2-b07a",
   "local": 0.15,
   "dur": 2.31,
   "t": 58.421
  },
  {
   "beat": "clip-07.b07",
   "scene": "b07b",
   "speaker": "hiep",
   "say": "Hay bạn nghĩ sao, có cách gì né cảnh đó, còm men kể mình nghe với nha.",
   "en": "How do you handle it? Tell me.",
   "emotion": "happy",
   "key": "c07v2-b07b",
   "local": 0.15,
   "dur": 3.939,
   "t": 61.131
  }
 ],
