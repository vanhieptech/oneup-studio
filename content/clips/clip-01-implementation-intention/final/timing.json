 "lines": [
  {
   "beat": "clip-01.b01",
   "scene": "b01",
   "speaker": "hiep",
   "say": "Kế hoạch học tô ích của mình là... mai học.",
   "en": "My TOEIC study plan: “tomorrow.”",
   "emotion": "sad",
   "key": "f5-1fd3d4f9e26f",
   "local": 0.12,
   "dur": 2.22,
   "t": 0.12
  },
  {
   "beat": "clip-01.b02",
   "scene": "b02",
   "speaker": "hiep",
   "say": "Tối nào cũng vậy: code xong, mệt, rồi ừm... thôi, mai học.",
   "en": "Every night: code, tired, then… “eh, tomorrow.”",
   "emotion": "sad",
   "key": "f5-6aeefa7b1dc0",
   "local": 0.55,
   "dur": 3.111,
   "t": 3.34
  },
  {
   "beat": "clip-01.b03",
   "scene": "b03",
   "speaker": "hiep",
   "say": "Hoá ra mình đâu có thiếu động lực. Mình thiếu một câu: nếu... thì...",
   "en": "Not missing motivation. Missing one sentence: IF… THEN…",
   "emotion": "focused",
   "key": "f5-78856042afa0",
   "local": 0.55,
   "dur": 3.713,
   "t": 7.451
  },
  {
   "beat": "clip-01.b04",
   "scene": "e01",
   "speaker": "hiep",
   "say": "Tâm lý học gọi nó là ý định thực hiện: viết sẵn mấy giờ, ở đâu, gặp gì, thì làm gì.",
   "en": "It's called an implementation intention: when, where, what cue, THEN what.",
   "emotion": "focused",
   "key": "f5-c933e99c9f43",
   "local": 0.65,
   "dur": 4.892,
   "t": 11.914
  },
  {
   "beat": "clip-01.b05",
   "scene": "e02",
   "speaker": "hiep",
   "say": "Vì mình quyết sẵn lúc còn tỉnh táo. Tới lúc mệt thì khỏi phải cãi với bản thân.",
   "en": "Decide while fresh. When the cue shows up, no debate with tired you.",
   "emotion": "focused",
   "key": "f5-a0abd0b93f0e",
   "local": 6.392,
   "dur": 4.25,
   "t": 17.656
  },
  {
   "beat": "clip-01.b06",
   "scene": "e03",
   "speaker": "hiep",
   "say": "Ví dụ: chín giờ tối, gập laptop, thì mở một bài listening.",
   "en": "Example: 9 PM, laptop closed, THEN one listening lesson.",
   "emotion": "neutral",
   "key": "f5-b0a363fd47f6",
   "local": 11.492,
   "dur": 3.135,
   "t": 22.756
  },
  {
   "beat": "clip-01.b07",
   "scene": "e04",
   "speaker": "hiep",
   "say": "Hoặc: sáng thứ ba tám giờ ngồi vào bàn, thì viết phần mở đầu trước.",
   "en": "Or: Tuesday 8 AM, at my desk, THEN write the intro first.",
   "emotion": "neutral",
   "key": "f5-5cfeb4fa02b9",
   "local": 15.477,
   "dur": 3.59,
   "t": 26.741
  },
  {
   "beat": "clip-01.b08",
   "scene": "e05",
   "speaker": "hiep",
   "say": "Gộp chín mươi tư kiểm nghiệm độc lập: người viết kiểu này đạt mục tiêu nhiều hơn rõ, hiệu ứng vừa tới lớn.",
   "en": "94 independent tests: if-then planners hit goals more often. Medium-to-large effect.",
   "emotion": "focused",
   "key": "f5-d6c887561754",
   "local": 19.917,
   "dur": 5.59,
   "t": 31.181
  },
  {
   "beat": "clip-01.b09",
   "scene": "e06",
   "speaker": "hiep",
   "say": "Nó giúp bạn bắt tay làm, đứng vững khi bị chen ngang, và dừng việc chắc chắn không thành.",
   "en": "It helps you start, hold on when interrupted, and quit what can't work.",
   "emotion": "neutral",
   "key": "f5-0707bb6fe571",
   "local": 26.357,
   "dur": 4.57,
   "t": 37.621
  },
  {
   "beat": "clip-01.b10",
   "scene": "e07",
   "speaker": "hiep",
   "say": "Lỗi hay gặp: rảnh thì học. Rảnh đâu phải tín hiệu. Phải là một giờ, một chỗ, hay một việc vừa xong.",
   "en": "Common mistake: “when I'm free.” Use a time, a place, or a finished task.",
   "emotion": "focused",
   "key": "f5-211d8c922d22",
   "local": 31.777,
   "dur": 5.81,
   "t": 43.041
  },
  {
   "beat": "clip-01.b11",
   "scene": "b11",
   "speaker": "hiep",
   "say": "Mà nhớ nha: chỉ hiệu quả với việc bạn thật sự muốn. Viết mất một, hai phút thôi.",
   "en": "Only works for goals you actually want. Takes 1–2 minutes.",
   "emotion": "focused",
   "key": "f5-ff7e30f15874",
   "local": 0.3,
   "dur": 4.48,
   "t": 49.454
  },
  {
   "beat": "clip-01.b12",
   "scene": "b12",
   "speaker": "hiep",
   "say": "Thử luôn đi: viết một câu nếu thì cho cái mai của bạn, rồi comment nha.",
   "en": "Try it now: one if-then line for your “tomorrow”. Comment it.",
   "emotion": "happy",
   "key": "f5-b9f9054b76dd",
   "local": 0.55,
   "dur": 3.58,
   "t": 54.934
  },
  {
   "beat": "clip-01.b12",
   "scene": "b12",
   "speaker": "hiep",
   "say": "Cái mai hết đường trốn rồi.",
   "en": "“Tomorrow” has nowhere to hide.",
   "emotion": "happy",
   "key": "f5-aa89c183bf41",
   "local": 4.33,
   "dur": 1.552,
   "t": 58.714
  }
 ],
