   "t": 37.763
  },
  {
   "beat": "clip-04.b07",
   "scene": "e07",
   "speaker": "hiep",
   "say": "Đun lốt ki xếp mười cách.",
   "en": "Dunlosky ranked ten methods",
   "emotion": "focused",
