 "lines": [
  {
   "beat": "clip-04.b01",
   "scene": "b01a",
   "speaker": "hiep",
   "say": "Học thuộc tối qua,",
   "en": "Memorized last night,",
   "emotion": "surprised",
   "key": "c04v18-c01a",
   "local": 0.0,
   "dur": 0.9,
   "t": 0.0
  },
  {
   "beat": "clip-04.b01",
   "scene": "b01a",
   "speaker": "hiep",
   "say": "sáng dậy quên sạch?",
   "en": "gone by morning?",
   "emotion": "surprised",
   "key": "c04v18-c01b",
   "local": 0.9,
   "dur": 0.8667,
   "t": 0.9
  },
  {
   "beat": "clip-04.b01",
   "scene": "b01b",
   "speaker": "hiep",
   "say": "Giả sử bây giờ không nhìn sách, bạn còn nhớ được những gì?",
   "en": "Book closed: what do you still remember?",
   "emotion": "confused",
   "key": "c04v18-c02",
   "local": 0.0,
   "dur": 2.9667,
   "t": 1.767
  },
  {
   "beat": "clip-04.b02",
   "scene": "b02a",
   "speaker": "hiep",
   "say": "Mình học ba mươi từ tiếng Anh, đọc đi đọc lại tới thuộc làu.",
   "en": "I reread thirty English words until fluent",
   "emotion": "happy",
   "key": "c04v18-c03",
   "local": 0.0,
   "dur": 3.2333,
   "t": 4.734
  },
  {
   "beat": "clip-04.b02",
   "scene": "b02b",
   "speaker": "hiep",
   "say": "Sáng dậy mình gấp sách viết thử,",
   "en": "Next morning, book closed, I wrote",
   "emotion": "focused",
   "key": "c04v18-c04",
   "local": 0.0,
   "dur": 1.7667,
   "t": 7.967
  },
  {
   "beat": "clip-04.b02",
   "scene": "b02c",
   "speaker": "hiep",
   "say": "tới từ thứ năm là hành lý thì mình bí.",
   "en": "Stuck at word five",
   "emotion": "confused",
   "key": "c04v18-c05",
   "local": 0.0,
   "dur": 2.1667,
   "t": 9.734
  },
  {
   "beat": "clip-04.b03",
   "scene": "b03a",
   "speaker": "hiep",
   "say": "Một thí nghiệm năm 2006 thấy,",
   "en": "A 2006 study found:",
   "emotion": "focused",
   "key": "c04v18-c06",
   "local": 0.0,
   "dur": 2.1,
   "t": 11.901
  },
  {
   "beat": "clip-04.b03",
   "scene": "b03b",
   "speaker": "hiep",
   "say": "nếu kiểm tra ngay thì nhóm đọc lại làm tốt hơn.",
   "en": "Tested at once, rereaders did better",
   "emotion": "neutral",
   "key": "c04v18-c07",
   "local": 0.0,
   "dur": 2.5333,
   "t": 14.001
  },
  {
   "beat": "clip-04.b03",
   "scene": "b03c",
   "speaker": "hiep",
   "say": "Nhưng hai ngày sau, nhóm tự kiểm tra lại nhớ hơn hẳn.",
   "en": "Two days later, self-testing remembered more",
   "emotion": "surprised",
   "key": "c04v18-c08",
   "local": 0.0,
   "dur": 2.9333,
   "t": 16.534
  },
  {
   "beat": "clip-04.b04",
   "scene": "b04",
   "speaker": "hiep",
   "say": "Mình cần là sáng hôm sau, gấp sách lại mình vẫn viết ra được.",
   "en": "Goal: book closed next morning, still recall",
   "emotion": "focused",
   "key": "c04v18-c09",
   "local": 0.0,
   "dur": 3.3,
   "t": 19.467
  },
  {
   "beat": "clip-04.b05",
   "scene": "b05a",
   "speaker": "hiep",
   "say": "Nên mình chia ba mươi từ thành ba phần, mỗi phần mười từ.",
   "en": "Thirty words, three parts of ten",
   "emotion": "focused",
   "key": "c04v18-c10",
   "local": 0.0,
   "dur": 3.1333,
   "t": 22.767
  },
  {
   "beat": "clip-04.b05",
   "scene": "b05b",
   "speaker": "hiep",
   "say": "Học hết phần nào, mình gấp sách viết lại phần đó,",
   "en": "Finish a part, close the book, write",
   "emotion": "focused",
   "key": "c04v18-c11",
   "local": 0.0,
   "dur": 2.6667,
   "t": 25.9
  },
  {
   "beat": "clip-04.b05",
   "scene": "b05c",
   "speaker": "hiep",
   "say": "chỗ nào bí mình mới mở sách.",
   "en": "Stuck? Only then open the book",
   "emotion": "confused",
   "key": "c04v18-c12",
   "local": 0.0,
   "dur": 1.5333,
   "t": 28.567
  },
  {
   "beat": "clip-04.b06",
   "scene": "b06a",
   "speaker": "hiep",
   "say": "Nhóm của Yang tổng hợp 222 nghiên cứu,",
   "en": "Yang 2021: 222 studies combined",
   "emotion": "focused",
   "key": "c04v18-c13",
   "local": 0.0,
   "dur": 2.8,
   "t": 30.1
  },
  {
   "beat": "clip-04.b06",
   "scene": "b06b",
   "speaker": "hiep",
   "say": "thấy lớp có kiểm tra nhỏ thì điểm cao hơn lớp không làm kiểm tra nhỏ, ở mức vừa.",
   "en": "Quizzed classes scored moderately higher",
   "emotion": "focused",
   "key": "c04v18-c14",
   "local": 0.0,
   "dur": 4.5667,
   "t": 32.9
  },
  {
   "beat": "clip-04.b07",
   "scene": "b07a",
   "speaker": "hiep",
   "say": "Sáng hôm sau, sách vẫn gấp,",
   "en": "Next morning, book still closed",
   "emotion": "neutral",
   "key": "c04v18-c15",
   "local": 0.0,
   "dur": 1.5,
   "t": 37.467
  },
  {
   "beat": "clip-04.b07",
   "scene": "b07b",
   "speaker": "hiep",
   "say": "mình tự viết được luggage,",
   "en": "I wrote luggage on my own",
   "emotion": "happy",
   "key": "c04v18-c16a",
   "local": 0.0,
   "dur": 1.4,
   "t": 38.967
  },
  {
   "beat": "clip-04.b07",
   "scene": "b07b",
   "speaker": "hiep",
   "say": "đúng chữ hành lý hôm trước mình bí.",
   "en": "The very word I got stuck on",
   "emotion": "happy",
   "key": "c04v18-c16b",
   "local": 1.4,
   "dur": 2.9,
   "t": 40.367
  },
  {
   "beat": "clip-04.b08",
   "scene": "b08a",
   "speaker": "hiep",
   "say": "Còn bạn, thử gấp sách lại thì viết được mấy từ?",
   "en": "Your turn: book closed, how many words?",
   "emotion": "happy",
