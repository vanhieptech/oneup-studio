 "lines": [
  {
   "beat": "clip-04.b01",
   "scene": "b01",
   "speaker": "hiep",
   "say": "Học thuộc tối qua, sáng dậy quên sạch?",
   "en": "Memorized last night, forgotten this morning?",
   "emotion": "surprised",
   "key": "c04v14-b01a",
   "local": 0.12,
   "dur": 2.199,
   "t": 0.12
  },
  {
   "beat": "clip-04.b01",
   "scene": "b01",
   "speaker": "hiep",
   "say": "Không nhìn sách, bạn có thể nhớ được những gì?",
   "en": "Without looking, what can you recall?",
   "emotion": "focused",
   "key": "c04v14-b01b",
   "local": 2.399,
   "dur": 2.768,
   "t": 2.399
  },
  {
   "beat": "clip-04.b02",
   "scene": "b02",
   "speaker": "hiep",
   "say": "Ví dụ học từ tiếng Anh để đi du lịch.",
   "en": "Example: thirty English travel words",
   "emotion": "neutral",
   "key": "c04v14-b02a",
   "local": 0.15,
   "dur": 2.264,
   "t": 5.377
  },
  {
   "beat": "clip-04.b02",
   "scene": "b02",
   "speaker": "hiep",
   "say": "Tối đọc đi đọc lại. Ba mươi từ, tới thuộc làu.",
   "en": "Reread them again that night",
   "emotion": "focused",
   "key": "c04v14-b02b",
   "local": 2.614,
   "dur": 3.026,
   "t": 7.841
  },
  {
   "beat": "clip-04.b02",
   "scene": "b02",
   "speaker": "hiep",
   "say": "Tưởng mai nhớ hết.",
   "en": "Thought I'd remember everything tomorrow",
   "emotion": "happy",
   "key": "c04v14-b02c",
   "local": 5.84,
   "dur": 0.991,
   "t": 11.067
  },
  {
   "beat": "clip-04.b03",
   "scene": "b03",
   "speaker": "hiep",
   "say": "Sáng dậy, gấp sách viết lại.",
   "en": "Morning: closed book, wrote back",
   "emotion": "focused",
   "key": "c04v14-b03a",
   "local": 0.15,
   "dur": 1.709,
   "t": 12.458
  },
  {
   "beat": "clip-04.b03",
   "scene": "b03",
   "speaker": "hiep",
   "say": "airport, hotel, ticket, passport.",
   "en": "airport, hotel, ticket, passport",
   "emotion": "focused",
   "key": "c04v14-b03b",
   "local": 2.059,
   "dur": 1.587,
   "t": 14.367
  },
  {
   "beat": "clip-04.b03",
   "scene": "b03",
   "speaker": "hiep",
   "say": "Tới từ thứ năm, hành lý. Bút dừng. Không nhớ từ tiếng Anh.",
   "en": "At fifth word, pen stopped",
   "emotion": "surprised",
   "key": "c04v14-b03c",
   "local": 3.846,
   "dur": 3.64,
   "t": 16.154
  },
  {
   "beat": "clip-04.b04",
   "scene": "b04",
   "speaker": "hiep",
   "say": "Mình chột dạ. Hay tối qua chỉ nhìn chữ đến quen mắt?",
   "en": "Had I only looked until familiar?",
   "emotion": "confused",
   "key": "c04v14-b04a",
   "local": 0.15,
   "dur": 3.11,
   "t": 20.194
  },
  {
   "beat": "clip-04.b04",
   "scene": "b04",
   "speaker": "hiep",
   "say": "Giấy trắng sau passport. Dừng ở đó.",
   "en": "Blank after passport on paper",
   "emotion": "sad",
   "key": "c04v14-b04b",
   "local": 3.46,
   "dur": 2.281,
   "t": 23.504
  },
  {
   "beat": "clip-04.b05",
   "scene": "b05",
   "speaker": "hiep",
   "say": "Viết không ra, mình mở sách.",
   "en": "When stuck, open book",
   "emotion": "focused",
   "key": "c04v14-b05a",
   "local": 0.15,
   "dur": 1.597,
   "t": 26.185
  },
  {
   "beat": "clip-04.b05",
   "scene": "b05",
   "speaker": "hiep",
   "say": "Xem đúng chỗ bí: lắc ghịt.",
   "en": "Check stuck spot: luggage",
   "emotion": "focused",
   "key": "c04v14-b05b",
   "local": 1.947,
   "dur": 1.662,
   "t": 27.982
  },
  {
   "beat": "clip-04.b05",
   "scene": "b05",
   "speaker": "hiep",
   "say": "Gấp lại, viết tiếp.",
   "en": "Close book, keep writing",
   "emotion": "happy",
   "key": "c04v14-b05c",
   "local": 3.809,
   "dur": 1.156,
   "t": 29.844
  },
  {
   "beat": "clip-04.b06",
   "scene": "e06",
   "speaker": "hiep",
   "say": "Giang gộp hai trăm hai mươi hai nghiên cứu.",
   "en": "Yang pooled 222 studies",
   "emotion": "focused",
   "key": "c04v14-b06a",
   "local": 0.65,
   "dur": 2.615,
   "t": 31.55
  },
  {
   "beat": "clip-04.b06",
   "scene": "e06",
   "speaker": "hiep",
   "say": "Hơn bốn mươi tám ngàn học sinh.",
   "en": "Over 48,000 students total",
   "emotion": "focused",
   "key": "c04v14-b06b",
   "local": 3.515,
   "dur": 1.673,
   "t": 34.415
  },
  {
   "beat": "clip-04.b06",
   "scene": "e06",
   "speaker": "hiep",
   "say": "Lớp có kiểm nhỏ.",
   "en": "Small quizzes in class",
   "emotion": "focused",
