   "dur": 1.359,
   "t": 39.917
  },
  {
   "beat": "clip-04.b07",
   "scene": "e07",
   "speaker": "hiep",
   "say": "Tự kiểm nằm nhóm cao nhất.",
   "en": "Self-testing in highest group",
   "emotion": "focused",
   "key": "c04v14-b07b",
   "local": 10.626,
   "dur": 1.625,
   "t": 41.526
  },
  {
   "beat": "clip-04.b07",
   "scene": "e07",
   "speaker": "hiep",
   "say": "Đọc lại, gạch chân nằm nhóm thấp nhất.",
   "en": "Rereading, highlighting in lowest group",
   "emotion": "focused",
   "key": "c04v14-b07c",
