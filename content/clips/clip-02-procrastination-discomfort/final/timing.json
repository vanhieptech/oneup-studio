 ],
 "lines": [
  {
   "beat": "clip-02.b01",
   "scene": "b01",
   "speaker": "hiep",
   "say": "Tính năng Omi.",
   "en": "The Omi feature.",
   "emotion": "sad",
   "key": "f5-326c41246390",
   "local": 0.12,
   "dur": 0.753,
   "t": 0.12
  },
  {
   "beat": "clip-02.b01",
   "scene": "b01b",
   "speaker": "hiep",
   "say": "Hoãn hôm nay. Hoãn ngày mai. Rồi lại hoãn.",
   "en": "Not today. Not tomorrow. Again.",
   "emotion": "sad",
   "key": "f5-4095f70a2567",
   "local": 0.06,
   "dur": 2.24,
   "t": 1.083
  },
  {
   "beat": "clip-02.b01",
   "scene": "b01c",
   "speaker": "hiep",
   "say": "Toang thật rồi.",
   "en": "It's over.",
   "emotion": "sad",
   "key": "f5-f79fbf5a67cf",
   "local": 0.06,
   "dur": 0.89,
   "t": 3.533
  },
  {
   "beat": "clip-02.b02",
   "scene": "b02",
   "speaker": "hiep",
   "say": "Mở code ra, năm giây sau đã lướt TikTok.",
   "en": "Open the code… five seconds later: TikTok.",
   "emotion": "sad",
   "key": "f5-2ec9b28a5ba0",
   "local": 0.3,
   "dur": 2.072,
   "t": 4.873
  },
  {
   "beat": "clip-02.b02",
   "scene": "b02",
   "speaker": "hiep",
   "say": "Chán nản, tội lỗi, rồi tự mắng: ừm... mình lười quá.",
   "en": "Drained, guilty: “I'm so lazy.”",
   "emotion": "sad",
   "key": "f5-14547a444848",
   "local": 2.572,
   "dur": 2.977,
   "t": 7.145
  },
  {
   "beat": "clip-02.b03",
   "scene": "b03",
   "speaker": "hiep",
   "say": "Nhưng nghiên cứu nói: thường đâu phải lười. Mình đang né một cảm giác.",
   "en": "Research says: usually not lazy. You're dodging a feeling.",
   "emotion": "focused",
   "key": "f5-0271eb2054b8",
   "local": 0.55,
   "dur": 3.799,
   "t": 11.122
  },
  {
   "beat": "clip-02.b04",
   "scene": "e01",
   "speaker": "hiep",
   "say": "Trì hoãn là né cảm giác khó chịu: chán, sợ làm dở, hay không biết bắt đầu. Nghe quen không?",
   "en": "Procrastination = dodging discomfort: boredom, fear of failing, no clear start. Sound familiar?",
   "emotion": "focused",
   "key": "f5-fd1d2dfea83a",
   "local": 0.65,
   "dur": 4.984,
   "t": 15.671
  },
  {
   "beat": "clip-02.b05",
   "scene": "e02",
   "speaker": "hiep",
   "say": "Gộp sáu trăm chín mươi mốt hệ số tương quan: việc càng khó chịu, càng thấy mình kém, càng dễ hoãn.",
   "en": "691 correlations: the nastier the task and the lower your confidence, the more you delay.",
   "emotion": "focused",
   "key": "f5-00112fb8fae8",
   "local": 6.484,
   "dur": 5.375,
   "t": 21.505
  },
  {
   "beat": "clip-02.b06",
   "scene": "e03",
   "speaker": "hiep",
   "say": "Vì phần thưởng ở xa, cái khó chịu ở ngay bây giờ. Nên điện thoại thắng.",
   "en": "Because the reward is far away, the discomfort is right now. So the phone wins.",
   "emotion": "focused",
   "key": "f5-ba77a972a011",
   "local": 12.709,
   "dur": 3.995,
   "t": 27.73
  },
  {
   "beat": "clip-02.b07",
   "scene": "e04",
   "speaker": "hiep",
   "say": "Nên trước khi làm, hỏi một câu: việc này khó chịu ở chỗ nào?",
   "en": "So before you start, ask: what exactly feels bad here?",
   "emotion": "focused",
   "key": "f5-6505e5807de7",
   "local": 17.554,
   "dur": 3.301,
   "t": 32.575
  },
  {
   "beat": "clip-02.b08",
   "scene": "e05",
   "speaker": "hiep",
   "say": "Không biết bắt đầu thì viết ba gạch đầu dòng, sợ dở thì cho phép nháp xấu.",
   "en": "No clear start? Write 3 bullets. Afraid it'll be bad? Allow an ugly draft.",
   "emotion": "focused",
   "key": "f5-7d0e3c4641ec",
   "local": 21.705,
   "dur": 3.96,
   "t": 36.726
  },
  {
   "beat": "clip-02.b09",
   "scene": "e06",
   "speaker": "hiep",
   "say": "Thấy chán thì hẹn mười phút, hết giờ là được dừng.",
   "en": "Bored? Set 10 minutes. When it rings, you may stop.",
   "emotion": "focused",
   "key": "f5-1eda90f9886a",
   "local": 26.515,
   "dur": 2.73,
   "t": 41.536
  },
  {
   "beat": "clip-02.b10",
   "scene": "e07",
   "speaker": "hiep",
   "say": "Lỗi hay gặp: mắng mình rồi gồng. Mắng xong, việc càng khó chịu.",
   "en": "Common mistake: scold yourself and force it. That makes the task feel worse.",
   "emotion": "focused",
   "key": "f5-ec90053679ba",
   "local": 30.095,
   "dur": 3.56,
   "t": 45.116
  },
  {
   "beat": "clip-02.b11",
   "scene": "b11",
   "speaker": "hiep",
   "say": "Lưu ý: nghiên cứu này là tương quan, chỉ cho thấy hướng. Lưu lại, lần sau hoãn thì mở ra.",
   "en": "Note: correlational, a pattern only. Save this for the next time you stall.",
   "emotion": "focused",
   "key": "f5-5e41f5a3ecac",
   "local": 0.3,
   "dur": 4.83,
   "t": 49.271
  },
  {
   "beat": "clip-02.b12",
   "scene": "b12",
   "speaker": "hiep",
   "say": "Việc bạn đang hoãn khó chịu chỗ nào? Comment một chữ.",
   "en": "What feels bad about the task you're avoiding? One word in the comments.",
   "emotion": "happy",
   "key": "f5-ea4c76dacef9",
   "local": 0.55,
   "dur": 2.89,
   "t": 55.101
  },
  {
   "beat": "clip-02.b12",
   "scene": "b12",
   "speaker": "hiep",
   "say": "Còn tính năng Omi? Mình đi hỏi câu đó đây.",
   "en": "And the Omi feature? Asking myself right now.",
   "emotion": "happy",
   "key": "f5-08542e06141e",
   "local": 3.64,
   "dur": 2.556,
   "t": 58.191
  }
 ],
